                <TextView android:id="@+id/day_5_4" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:textSize="13sp" android:textColor="#FF1C1B1F" />
                <ImageView android:id="@+id/dot_5_4" android:layout_width="5dp" android:layout_height="5dp" android:src="@drawable/widget_cal_dot" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/day_5_5" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:textSize="13sp" android:textColor="#FF1C1B1F" />
                <ImageView android:id="@+id/dot_5_5" android:layout_width="5dp" android:layout_height="5dp" android:src="@drawable/widget_cal_dot" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/day_5_6" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:textSize="13sp" android:textColor="#FF1C1B1F" />
                <ImageView android:id="@+id/dot_5_6" android:layout_width="5dp" android:layout_height="5dp" android:src="@drawable/widget_cal_dot" android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/cal_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:background="#1A000000" />

        <!-- Upcoming events label -->
        <TextView
            android:id="@+id/cal_events_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prossimi eventi"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#99000000"
            android:paddingBottom="2dp" />

        <!-- Scrollable event list -->
        <ListView
            android:id="@+id/cal_events_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:fadingEdge="none" />

        <!-- Empty state when no events -->
        <TextView
            android:id="@+id/cal_no_events"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Nessun evento in programma"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="#66000000"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
